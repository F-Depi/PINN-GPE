\@writefile{toc}{\contentsline {section}{\numberline {1}1D Gross-Pitaevskii equation With Harmonic Potential}{1}{}\protected@file@percent }
\newlabel{sec:1d_gpe}{{1}{1}}
\newlabel{eq:GPE}{{1}{1}}
\newlabel{eq:ex1_loss}{{2}{1}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Results for the 1D GPE with $Na = 1$ using a NN with 1 hidden layer and 4 neurons per layer (N4L1). The final loss was $2.66 \times 10^{-5}$, the relative $\mathbb  L_2$ is $4.67 \times 10^{-4}$ computed with respect to the \texttt  {Numerov} solution obtained from the previous reports. \texttt  {L-BFGS} optimizer was stopped after 100 iterations with the same loss.\relax }}{2}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:1d_gpe_N4L1_Na1}{{1}{2}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Results for the 1D GPE with $Na = 10$ using a NN with N4L1. The final loss was $9.46 \times 10^{-7}$, the relative $\mathbb  L_2$ error is $9.55 \times 10^{-5}$ computed with respect to the \texttt  {Numerov} solution obtained from the previous reports. \texttt  {L-BFGS} optimizer was stopped after 100 iterations with the same loss.\relax }}{2}{}\protected@file@percent }
\newlabel{fig:1d_gpe_N4L1_Na10}{{2}{2}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Loss and relative $\mathbb  {L}_2$ error for different NN architectures for the 1D GPE with $Na = 0$ (analytical solution available). Results are consistently good across all architectures from 4 neurons per layer, with no clear improvement observed for more complex architectures.\relax }}{3}{}\protected@file@percent }
\newlabel{tab:1d_gpe}{{1}{3}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Loss and relative $\mathbb  {L}_2$ error for different numbers of sample points for the 1D GPE with $Na = 0$, using a sufficiently expressive NN with N16L3. The $\mathbb  {L}_2$ error decreases significantly as the number of points increases from 10 to 1000, but does not show a clear improvement beyond that. Low loss is generally correlated with low $\mathbb  {L}_2$ error, as expected.\relax }}{3}{}\protected@file@percent }
\newlabel{tab:1d_gpe_Npoints}{{2}{3}}
