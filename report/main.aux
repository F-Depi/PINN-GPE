\abx@aux@page{5}{14}
\@writefile{toc}{\contentsline {section}{\numberline {A}The Eigenvalue Problem}{15}{}\protected@file@percent }
\newlabel{app:eigenvalue}{{A}{15}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces 1D GPE with $g = 0$ and a harmonic potential. The same NN correctly learns 6 eigenstates (that in this case are known analytically) but misses the 5th one.\relax }}{16}{}\protected@file@percent }
\newlabel{fig:ex3.5_harmonic_eigen}{{20}{16}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Results for the 1D GPE with $g = 1$ and a symmetric double well potential from equation \eqref  {eq:dw} with $a = 2$ using a NN with N16L3.\relax }}{16}{}\protected@file@percent }
\newlabel{fig:ex3.5_dw2_eigen}{{21}{16}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Results for the 1D GPE with $g = 1$ and a non-symmetric double well potential from equation \eqref  {eq:dw_as} with $a = 1$ and $b = 6$ using a NN with N16L3.\relax }}{16}{}\protected@file@percent }
\newlabel{fig:ex3.5_dw1_as6_eigen}{{22}{16}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Comparison of the results obtained for the double well potential with $a = 2$ and $g = 1$ with the method of section \ref {sec:1d_double_well} (solid blue line) and the method of Appendix \ref {app:eigenvalue} (orange dotted line).\relax }}{17}{}\protected@file@percent }
\newlabel{fig:ex3.5_dw2_check}{{23}{17}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Comparison of the results obtained for the non-symmetric double well potential with $a = 1$, $b = 6$ and $g = 1$ with the method of section \ref {sec:1d_double_well} (solid blue line) and the method of Appendix \ref {app:eigenvalue} (orange dotted line).\relax }}{17}{}\protected@file@percent }
\newlabel{fig:ex3.5_dw1_as6_check}{{24}{17}}
\@writefile{lof}{\contentsline {figure}{\numberline {25}{\ignorespaces Five eigenstates of the 2D GPE with $g = 1$ and a harmonic potential, computed with a N32L4 NN. The ground state ($n = 3$) and two pairs of degenerate excited states are found, with the degeneracy consistent with the rotational symmetry of the harmonic potential.\relax }}{17}{}\protected@file@percent }
\newlabel{fig:ex3.5_2D_harmonic_eigen}{{25}{17}}
\@writefile{toc}{\contentsline {section}{\numberline {B}Spread-Out Potential}{18}{}\protected@file@percent }
\newlabel{app:spread_out_potential}{{B}{18}}
\newlabel{eq:spread_out_potential}{{21}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces External potential $V_{\rm  ext}(x,y)$ defined in \eqref  {eq:spread_out_potential} (left) and corresponding ground-state solution $\psi (x,y)$ (right) obtained with an N32L3 network for $g=1000$. The strong interaction leads to a wave function that spreads over multiple rings of local minima.\relax }}{18}{}\protected@file@percent }
\newlabel{fig:ex3_quasicrystal_g1000}{{26}{18}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Ground-state solutions $\psi (x,y)$ obtained during the continuation procedure as $g$ is reduced. Left: $g=106.6$. Right: $g=10.5$. As the interaction strength decreases, the solution becomes progressively more localized around the energetically favorable rings.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:ex3_quasicrystal_intermediate}{{27}{19}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Ground-state solution for $g=1$ computed with additional sampling points to improve resolution. On the right we stretch the color scale to better visualize the value of the wave function close to 0 and observe that the solution still conserves the shape of the potential in the outer ring of wells. For weak interactions, the wave function concentrates primarily in the innermost ring, even though the middle wells are deeper.\relax }}{19}{}\protected@file@percent }
\newlabel{fig:ex3_quasicrystal_g1}{{28}{19}}
