\@writefile{toc}{\contentsline {section}{\numberline {3}Gross-Pitaevskii equation Under Various Potentials}{5}{}\protected@file@percent }
\newlabel{sec:double_well}{{3}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}1D Double Well}{5}{}\protected@file@percent }
\newlabel{sec:1d_double_well}{{3.1}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Slices of the results for the time-dependent GPE with N32L3. We can appreciate the NN ability to capture the solution even in the highly nonlinear regions of the domain.\relax }}{6}{}\protected@file@percent }
\newlabel{fig:2d_gpe_N32L3_slice}{{5}{6}}
\newlabel{eq:dw}{{4}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Results for the 1D GPE with the symmetric double well potential from equation \eqref  {eq:dw} with $a = 1$ and $g = 1$ using a NN with N4L2.\relax }}{6}{}\protected@file@percent }
\newlabel{fig:ex3_dw1_easy}{{6}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Results for the 1D GPE with the symmetric double well potential from equation \eqref  {eq:dw} with $a = 2$ and $g = 1$ using a NN with N4L2.\relax }}{6}{}\protected@file@percent }
\newlabel{fig:ex3_dw2_oops}{{7}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Another failed attempt at finding the ground state of the system under the potential in equation \eqref  {eq:dw}, this time we also tried to enforce positivity and used a gaussian initialization. Increasing the NN complexity or the number of sample points had no effect.\relax }}{7}{}\protected@file@percent }
\newlabel{fig:ex3_dw2_shit}{{8}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Increasing the strength of the interaction forces the wave function to expand over both the wells. This time we are confident that we found the ground state given the symmetry and the Loss of $2.9 \times 10^{-4}$.  \relax }}{7}{}\protected@file@percent }
\newlabel{fig:ex3_dw2_yee_g100}{{9}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Starting from the NN trained at $g = 100$ in Figure \ref {fig:ex3_dw2_yee_g100} and optimizing it for $g = 1$ we can find the ground state solution for the double well potential with $a = 2$.\relax }}{7}{}\protected@file@percent }
\newlabel{fig:ex3_dw2_yee_g1}{{10}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces N16L2 positive NN trained for $g = 100$ and then retrained for $g = 1$ with the non-symmetric double well potential from equation \eqref  {eq:dw_as} with $a = 1$ and $b = 6$. The wave function is more localized in the left well, as expected.\relax }}{7}{}\protected@file@percent }
\newlabel{fig:ex3_dw1_as6}{{11}{7}}
\newlabel{eq:dw_as}{{5}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}2D Double Well}{8}{}\protected@file@percent }
\newlabel{sec:2d_double_well}{{3.2}{8}}
\newlabel{eq:2D_loss}{{6}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Results for the 2D GPE with a harmonic potential and $g = 1$ using a NN with N32L3. Gaussian initialization was used to help the optimizer.\relax }}{8}{}\protected@file@percent }
\newlabel{fig:ex3_2D_N32L3_g1_harmonic}{{12}{8}}
\newlabel{eq:dw_as_2d}{{7}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 2D GPE with the asymmetric double well potential from equation \eqref  {eq:dw_as_2d} and $g = 40$, using a NN with N32L3. At high interaction strength the wave function easily spreads over both wells.\relax }}{9}{}\protected@file@percent }
\newlabel{fig:ex3_2D_N32L3_g40_dw2_as6_gauss}{{13}{9}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces The NN of Figure \ref {fig:ex3_2D_N32L3_g40_dw2_as6_gauss} retrained for $g = 1$. The wave function is now more localized in the lower well of the asymmetric potential, as expected.\relax }}{9}{}\protected@file@percent }
\newlabel{fig:ex3_2D_N32L3_g1_dw2_as6_high_g}{{14}{9}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}A Modulated Mexican Hat}{10}{}\protected@file@percent }
\newlabel{sec:complex_2d_traps}{{3.3}{10}}
\newlabel{eq:weird_potential}{{8}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Stationary solution of the 2D GPE with the potential \eqref  {eq:weird_potential} at $\mathcal  E=0.4$ and $g=1$, obtained with a N32L3 PINN. The wave function follows the five-fold modulation of the external trap along the ring. The potential minima are denoted with a $\blacktriangledown $ symbol and are all $V_{\rm  min} \simeq 0.40$ deep, while the maxima of the wave-function are denoted with a $\blacktriangle $ symbol and are all $\psi _{\rm  max} \simeq 0.38$ high.\relax }}{10}{}\protected@file@percent }
\newlabel{fig:ex3_2D_N32L3_g1_crazy_eps0.4}{{15}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Same as Figure~\ref {fig:ex3_2D_N32L3_g1_crazy_eps0.4}, but with a much stronger angular corrugation, $\mathcal  E = 10$ meaning that the angular barriers are $\Delta V \simeq 20$ high. Even in this stiff regime the PINN converges to a solution that captures the sharp modulation and the increased localization in the angular minima. The potential minima are denoted with a $\blacktriangledown $ symbol and are all $V_{\rm  min} \simeq -10$ deep, while the maxima of the wave-function are denoted with a $\blacktriangle $ symbol and are all $\psi _{\rm  max} \simeq 0.64$ high.\relax }}{11}{}\protected@file@percent }
\newlabel{fig:ex3_2D_N32L3_g1_crazy_eps10}{{16}{11}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Vortex Solutions}{11}{}\protected@file@percent }
\newlabel{sec:vortex}{{4}{11}}
\newlabel{eq:vortex_gpe}{{9}{11}}
\newlabel{eq:vortex_ansatz}{{10}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Vortex solution of the 2D GPE with $g = 1$ and winding number $m = 1$, obtained with a NN with N32L4.\relax }}{12}{}\protected@file@percent }
\newlabel{fig:vortex_l1}{{17}{12}}
\newlabel{eq:vortex_loss}{{11}{12}}
\newlabel{eq:vortex_lpde}{{12}{12}}
\newlabel{eq:vortex_lbc}{{13}{12}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Vortex solution of the 2D GPE with $g = 1$ and winding number $m = 3$, the vortex is bigger than the one with $m = 1$.\relax }}{13}{}\protected@file@percent }
\newlabel{fig:vortex_l3}{{18}{13}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Vortex solution of the 2D GPE with $g = 10$. When the interaction is stronger the vortex is smaller, allowing to find a solution with a higher winding number $m = 6$ in a small domain.\relax }}{13}{}\protected@file@percent }
\newlabel{fig:vortex_l6}{{19}{13}}
